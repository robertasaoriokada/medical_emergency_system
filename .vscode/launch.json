      "request": "launch",
      "mainClass": "com.example.services.AttendanceNode",
      "projectName": "demo"
    },
    {
      "type": "java",
      "name": "TCPClient",
      "request": "launch",
      "mainClass": "com.example.services.TCPClient",
      "projectName": "demo"
    },
    {
      "type": "java",
      "name": "TCPService",
      "request": "launch",
      "mainClass": "com.example.services.TCPService",
      "projectName": "demo"
    },
    {
      "type": "java",
      "name": "Main",
      "request": "launch",
      "mainClass": "com.example.Main",
      "projectName": "demo"
    },
    {
      "type": "java",
      "name": "ServidorCentral",
      "request": "launch",
