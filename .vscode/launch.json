    {
      "type": "java",
      "name": "NoAtendimento",
      "request": "launch",
      "mainClass": "com.example.NoAtendimento",
      "env": {
        "SERVIDOR_HOST": "127.0.0.1",
        "SERVIDOR_PORT": "9000"
